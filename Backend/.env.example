
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:Your_Passowrd@localhost:5432/sacco_evs

JWT_ACCESS_SECRET=replace-with-a-random-32+-char-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32+-char-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Distributed administrative trust (quorum governance)
TRUST_THRESHOLD_M=3
TRUST_POOL_SIZE_N=5
TRUST_ACTION_EXPIRY_HOURS=48