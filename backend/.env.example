NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:your-password@localhost:5432/sevs"
DATABASE_TEST_URL="postgresql://postgres:your-password@localhost:5432/sevs_test"

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

TOTP_ISSUER=SEVS

# Used to encrypt Vote.encryptedPayload (AES-256-GCM) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-64-char-hex-string

CORS_ORIGIN=http://localhost:3000