NODE_ENV=development
PORT=4000

DATABASE_URL="postgresql://postgres:your-password@localhost:5432/sevs"
DATABASE_TEST_URL="postgresql://postgres:your-password@localhost:5432/sevs_test"

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

TOTP_ISSUER=SEVS

# Used to encrypt Vote.encryptedPayload (AES-256-GCM) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-with-a-64-char-hex-string

CORS_ORIGIN=http://localhost:3000

# Optional: Copilot (Gemini). Without a key the Copilot endpoint returns 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Failed login/MFA/refresh/register attempts allowed per IP per 15 minutes.
# Successful requests do not count. Keep 10 outside local testing.
AUTH_RATE_LIMIT_MAX=10

# Number of reverse proxies in front of the app (0 = none). Set to 1 behind Nginx.
TRUST_PROXY_HOPS=0

# Time zone for the governance off-hours rule (IANA name).
GOVERNANCE_TIMEZONE=Africa/Nairobi

# Background job: auto-closes elections at endDate and expires stale approval
# requests. Keep it enabled on exactly one server instance.
SCHEDULER_ENABLED=true
# How often it runs, in milliseconds (minimum 5000). Default: every minute.
SCHEDULER_INTERVAL_MS=60000

# DEVELOPMENT ONLY. true = no two-factor code at login, and staff are not
# forced to set it up. Works only with NODE_ENV=development; the server will
# not start with it in production. Logins are marked in the audit log.
DEV_SKIP_MFA=false
# Questions to the AI assistants allowed per user per 15 minutes.
AI_RATE_LIMIT_MAX=20